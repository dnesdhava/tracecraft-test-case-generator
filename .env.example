# Google AI Studio configuration. Keep the API key in the backend environment only.
TCG_AI_PROVIDER=google
# Set one backend-only key variable. TCG_AI_API_KEY is the project default.
TCG_AI_API_KEY=
# Google AI Studio standard aliases are also accepted when TCG_AI_API_KEY is unset.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
TCG_AI_MODEL_NAME=Gemma 4:31B
TCG_AI_MODEL_ID=gemma-4-31b-it
TCG_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
TCG_AI_TIMEOUT_SECONDS=30
TCG_AI_MAX_OUTPUT_TOKENS=1024
TCG_AI_FALLBACK_ENABLED=true
TCG_STORAGE_BASE_DIR=./storage
TCG_AUDIT_LOG_PATH=./storage/audit.jsonl
TCG_SECURITY_AUDIT_LOG_PATH=./storage/security-audit.jsonl
TCG_MAX_UPLOAD_BYTES=52428800
TCG_REQUIRE_APPROVED_EXPORT=false
TCG_LOG_LEVEL=INFO
TCG_LOG_FORMAT=json
